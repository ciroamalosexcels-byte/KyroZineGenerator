{
  "name": "kyro-zine-generator-desktop",
  "version": "1.4.0",
  "description": "Kyro Zine Generator: app de escritorio con servidor para editar en la red local",
  "main": "main.js",
  "author": "Kyro",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "prepare-app": "node scripts/copy-app.js",
    "start": "npm run prepare-app && electron .",
    "serve": "npm run prepare-app && node server.js",
    "dist": "npm run prepare-app && electron-builder --win nsis --x64",
    "dist:win7": "npm run prepare-app && electron-builder --win nsis --x64 --config.electronVersion=22.3.27 --config.win.artifactName=Kyro-Zine-Generator-Setup-${version}-Windows7.exe --config.directories.output=dist-win7"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "ar.kyro.zinegenerator",
    "productName": "Kyro Zine Generator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "app/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "Kyro-Zine-Generator-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kyro Zine Generator",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Kyro Zine Generator",
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082"
    },
    "afterPack": "scripts/after-pack.js",
    "fileAssociations": [
      {
        "ext": "kyro",
        "name": "Proyecto Kyro Zine",
        "description": "Proyecto de Kyro Zine Generator",
        "icon": "build/icon.ico",
        "role": "Editor"
      }
    ]
  }
}
